[Unit]
Description=Doorboard ambient display server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/doorboard
# Optional; holds DOORBOARD_CLIMATE_DSN (bathroom sensor Postgres URL, has a
# password). Root-owned 0600, never in git. Missing file is fine — the board
# just hides the humidity readout.
EnvironmentFile=-/etc/doorboard.env
ExecStart=/usr/bin/python3 /home/pi/doorboard/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
